{
  "name": "solfa-reader",
  "private": true,
  "version": "0.1.0",
  "description": "Scan or type a tonic sol-fa score and hear each choir voice (S, A, T, B). Runs fully in the browser.",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-tesseract-assets.mjs",
    "dev": "npm run assets && vite",
    "build": "npm run assets && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
